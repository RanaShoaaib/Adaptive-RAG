# Use the HTTP and gRPC endpoints for your Weaviate deployment.
# Host values are hostnames only, without a scheme, port, or path.
WEAVIATE_HTTP_HOST=weaviate.example.com
WEAVIATE_HTTP_PORT=443
WEAVIATE_HTTP_SECURE=true
WEAVIATE_GRPC_HOST=grpc.weaviate.example.com
WEAVIATE_GRPC_PORT=443
WEAVIATE_GRPC_SECURE=true
WEAVIATE_API_KEY=

# Required only to generate teacher plans in notebook 01.
OPENAI_API_KEY=
OPENAI_TEACHER_MODEL=
